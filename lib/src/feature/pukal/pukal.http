------------------------------------------------
--To list all PUKAL inbound failure records which is to allow user maintains  
------------------------------------------------
EXEC ApiMgmtCustBillingAcctPukalInboundTxnList
@PId tPrcsId = NULL,
@RunId bigint = NULL,
@RptInd tRefCd = 'PRE',
@UserId tUserId = NULL,
@SrcIpAddr tSrcIpAddr = NULL,
@MsgId tMsgId OUTPUT

###
POST {{baseUrl}}/sp/ApiMgmtCustBillingAcctPukalInboundTxnList/queryasync HTTP/1.1
Authorization: Bearer {{authorization}}
content-type: application/json

{
//	"PId":null,
//	"RunId": null,
	"PrgEttyId":1,
	//"RptInd": "PRE"
}

------------------------------------------------
--User to save a new PUKAL outbound record derive from a failure transaction. Getting them to re-send
------------------------------------------------
EXEC ApiMgmtCustBillingAcctPukalInboundTxnSave
@PrgEttyId bigint,
@PukalId bigint,
@AcctId bigint,
@TxnId bigint,
@LinkTxnId bigint OUTPUT,
@BillAmt money,
@UserId tUserId = NULL,
@SrcIpAddr tIpAddr = NULL,
@MsgId tMsgId OUTPUT


------------------------------------------------
--Enable user to re-run the PUKAL outbound report & files to check their maintained specific records
------------------------------------------------
EXEC ApiRptFilePukalTxnRerun
@PId tPrcsId = NULL,
@RunId bigint = NULL,
@RptInd tRefCd = 'PREVIEW',
@UserId tUserId = NULL,
@SrcIpAddr tSrcIpAddr = NULL,
@MsgId tMsgId OUTPUT

------------------------------------------------
--Host to generates final PUKAL outbound files and reports after user click to confirm there
------------------------------------------------
EXEC ApiRptFilePukalTxnSave
@RptType tRefCd,
@PId tPrcsId,
@RunId bigint OUTPUT,
@UserId tUserId = NULL,
@SrcIpAddr tSrcIpAddr = NULL,
@MsgId tMsgId OUTPUT

